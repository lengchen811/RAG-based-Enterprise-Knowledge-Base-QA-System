# ===== 企业知识库问答系统 环境变量模板 =====
# 复制为 .env 并填写真实值

# ---- 通义千问（DashScope）----
# 必填：阿里云百炼控制台创建 API Key
DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxx

# ---- 数据库 ----
# docker-compose 内置的 MySQL 连接串（与 compose 内服务名一致）
DATABASE_URL=mysql+asyncmy://rag:rag2024@mysql:3306/ragdb

# ---- Redis ----
REDIS_URL=redis://redis:6379/0

# ---- 认证 ----
# 生产环境务必更换为随机强密钥
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET

# ---- 可观测性（可选，留空则关闭）----
# 是否启用 LangSmith 全链路追踪
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=enterprise-rag

# ---- 模型选择（可选）----
# LLM_MODEL=qwen-plus
# EMBEDDING_MODEL=text-embedding-v3
# RERANK_MODEL=gte-rerank